new file mode 100644
--- /dev/null
+++ b/internal/forge/native_group_default_test.go
@@ -0,0 +1,28 @@
+package forge
+
+import (
+	"github.com/StephenSHorton/wc3-forge/internal/formats/doodadsdoo"
+	"github.com/StephenSHorton/wc3-forge/internal/formats/unitsdoo"
+	"testing"
+)
+
+func TestNativeNewPlacementsAreUngrouped(t *testing.T) {
+	s := &Session{loaded: true, units: &unitsdoo.File{Version: 13, SubVersion: 11}, doodads: &doodadsdoo.File{Version: 13, SubVersion: 11}}
+	if _, err := s.CreateUnit("hfoo", 26, [3]float32{}, 0, 1); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CreateStartLocation(0, [3]float32{}, 0); err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range s.units.Entities {
+		if e.GroupID != 0xffffffff {
+			t.Errorf("%s group=%d; want native ungrouped sentinel", e.TypeID, e.GroupID)
+		}
+	}
+	if _, err := s.CreateDoodad("LOlp", [3]float32{}, 0, 1, 0); err != nil {
+		t.Fatal(err)
+	}
+	if s.doodads.Doodads[0].GroupID != 0xffffffff {
+		t.Errorf("doodad group=%d; want ungrouped", s.doodads.Doodads[0].GroupID)
+	}
+}
